<?xml version="1.0" encoding="utf-8"?>
<!-- Resizable agenda widget. Refreshed by DateCtrl when the calendar storage changes and after midnight;
     updatePeriodMillis (3 hours) is only a fallback. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_agenda"
    android:previewLayout="@layout/widget_agenda"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:minResizeWidth="140dp"
    android:minResizeHeight="110dp"
    android:maxResizeWidth="1200dp"
    android:maxResizeHeight="1200dp"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:updatePeriodMillis="10800000"
    android:widgetCategory="home_screen" />